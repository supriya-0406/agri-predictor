        """Enhanced cross-breeding prediction with species compatibility"""
        male_species = str(male_species).lower().strip()
        male_breed = str(male_breed).lower().strip()
        female_species = str(female_species).lower().strip()
        female_breed = str(female_breed).lower().strip()
        region = str(region).lower().strip()
        
        if self.breed_model is None:
            return {"error": "Model not loaded"}
        
        try:
            is_cross_species = male_species != female_species
            is_cross_breed = male_breed != female_breed
            
            COMPATIBILITY = {
                ('cow', 'cow'): 0.95, ('buffalo', 'buffalo'): 0.95,
                ('goat', 'goat'): 0.95, ('sheep', 'sheep'): 0.95,
                ('cow', 'buffalo'): 0.0, ('buffalo', 'cow'): 0.0,
                ('goat', 'sheep'): 0.3, ('sheep', 'goat'): 0.3,
            }
            
            base_compat = COMPATIBILITY.get((male_species, female_species), 0.5)
            
            if base_compat == 0.0:
                return {
                    "error": f"Cross-breeding {male_species} × {female_species} is biologically impossible",
                    "compatibility_score": 0,
                    "recommendation": f"{male_species.title()} and {female_species.title()} cannot be cross-bred. They are different species.",
                    "male_species": male_species, "male_breed": male_breed,
                    "female_species": female_species, "female_breed": female_breed,
                    "suggestion": f"Try breeding within the same species (e.g., {male_species} × {male_species})"
                }
            
            primary_species = male_species
            primary_breed = male_breed
            
            encoded_vals = {}
            mapping = {
                'species': primary_species, 'breed': primary_breed, 'region': region,
                'male_age': float(m_age), 'female_age': float(f_age),
                'male_weight_kg': float(m_wt), 'female_weight_kg': float(f_wt),
                'female_milk_yield_lpd': float(f_milk), 'health_score': float(health),
                'genetic_diversity_idx': float(genetics)
            }
            
            for col, val in mapping.items():
                if col in self.breed_features:
                    if isinstance(val, str):
                        le = self.breed_encoders.get(f'le_{col}')
                        if le:
                            try:
                                encoded_vals[col] = le.transform([val])[0]
                            except ValueError:
                                encoded_vals[col] = 0
                        else:
                            encoded_vals[col] = 0
                    else:
                        encoded_vals[col] = val
            
            X = pd.DataFrame([encoded_vals], columns=self.breed_features)
            preds = self.breed_model.predict(X)[0]
            
            base_success = float(preds[3])
            
            if is_cross_breed and not is_cross_species:
                hybrid_vigor = 1.08
                base_success = min(0.95, base_success * hybrid_vigor)
                breed_type = "cross-breed"
            elif not is_cross_breed:
                breed_type = "pure-breed"
            else:
                breed_type = "cross-species (rare)"
            
            offspring_weight = float(preds[0])
            milk_potential = float(preds[1])
            disease_resistance = float(preds[2])
            success_prob = base_success * base_compat
            
            if success_prob > 0.80:
                rec = f"🎯 EXCELLENT MATCH ({success_prob*100:.1f}%): Ideal {breed_type} pairing. High genetic diversity."
            elif success_prob > 0.60:
                rec = f"✅ GOOD MATCH ({success_prob*100:.1f}%): Compatible {breed_type}. Expected healthy offspring."
            elif success_prob > 0.40:
                rec = f"⚠️ MODERATE MATCH ({success_prob*100:.1f}%): Consider consulting a veterinarian."
            else:
                rec = f"❌ LOW COMPATIBILITY ({success_prob*100:.1f}%): Not recommended. Try different pairing."
            
            compatibility_score = round(success_prob * 100, 1)
            
            return {
                "male_species": male_species, "male_breed": male_breed,
                "female_species": female_species, "female_breed": female_breed,
                "region": region, "breeding_type": breed_type,
